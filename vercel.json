{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|ico|svg|webp|avif|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/index",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/case-studies/index",
      "destination": "/case-studies",
      "permanent": true
    },
    {
      "source": "/blogs",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/guides",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/case-study",
      "destination": "/case-studies",
      "permanent": true
    },
    {
      "source": "/bg/index",
      "destination": "/bg",
      "permanent": true
    },
    {
      "source": "/bg/blog/index",
      "destination": "/bg/blog",
      "permanent": true
    },
    {
      "source": "/bg/case-studies/index",
      "destination": "/bg/case-studies",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/bg/case-studies/:slug",
      "destination": "/bg-case-:slug"
    },
    {
      "source": "/bg/blog/:slug",
      "destination": "/bg-blog-:slug"
    },
    {
      "source": "/bg/:page",
      "destination": "/bg-:page"
    },
    {
      "source": "/case-studies/:slug",
      "destination": "/case-:slug"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog-:slug"
    }
  ]
}
